# Copy to .env and fill in. Every default below is a free, local value that
# works with `docker compose up` in the repo root -- no paid account required.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Async SQLAlchemy URL. Local default matches docker-compose.yml's `postgres` service.
DATABASE_URL=postgresql+asyncpg://masea:masea@localhost:5432/masea

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# LLM provider: "ollama" (free, local, default) or "fake" (tests only)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# S3-compatible object storage. Local default is MinIO (see docker-compose.yml).
# To use real AWS S3 in production, set S3_ENDPOINT_URL to an empty value and
# provide real AWS credentials/region.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_REPOSITORIES=masea-repositories
S3_REGION=us-east-1

MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=masea-evals

# Leave blank to disable OTLP export and log spans to console instead.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=masea-backend
ENABLE_PROMETHEUS=true

RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

INGESTION_MAX_REPO_SIZE_MB=500
INGESTION_CLONE_TIMEOUT_SECONDS=120
PATCH_SANDBOX_TIMEOUT_SECONDS=60
WORKSPACE_ROOT=./.workspace

CORS_ALLOW_ORIGINS=["http://localhost:5173"]
