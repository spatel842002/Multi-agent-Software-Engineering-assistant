# Environment for `docker compose up` at the repo root. All values here are
# local-only defaults for the free, self-hosted stack (Postgres, Redis,
# Qdrant, Ollama, MinIO, MLflow, Prometheus, Grafana) -- nothing here is a
# real secret or reachable outside the compose network. Generate a real
# JWT_SECRET_KEY for any shared/deployed environment.

ENVIRONMENT=development
LOG_LEVEL=INFO

JWT_SECRET_KEY=local-docker-compose-dev-secret-not-for-production-use-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

DATABASE_URL=postgresql+asyncpg://masea:masea@postgres:5432/masea

REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=code_chunks

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_REPOSITORIES=masea-repositories
S3_REGION=us-east-1

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=masea-evals

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=masea-backend
ENABLE_PROMETHEUS=true

RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

INGESTION_MAX_REPO_SIZE_MB=500
INGESTION_CLONE_TIMEOUT_SECONDS=120
PATCH_SANDBOX_TIMEOUT_SECONDS=60
WORKSPACE_ROOT=/app/.workspace

CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]
