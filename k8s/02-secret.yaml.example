# Template only -- copy to 02-secret.yaml, fill in real values, and NEVER
# commit the filled-in version (it's covered by k8s/.gitignore). In a real
# cluster, prefer a secrets manager integration (External Secrets Operator,
# Sealed Secrets, or your cloud provider's CSI secret store) over a plain
# committed/applied Secret manifest.
apiVersion: v1
kind: Secret
metadata:
  name: masea-backend-secrets
  namespace: masea
type: Opaque
stringData:
  JWT_SECRET_KEY: "REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32"
  DATABASE_URL: "postgresql+asyncpg://USER:PASSWORD@HOST:5432/masea"
  REDIS_URL: "redis://HOST:6379/0"
  QDRANT_API_KEY: ""
  S3_ACCESS_KEY: "REPLACE_ME"
  S3_SECRET_KEY: "REPLACE_ME"
