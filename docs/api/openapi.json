  "components": {
    "schemas": {
      "ApprovalDecision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ],
        "title": "ApprovalDecision"
      },
      "BugInvestigationRequest": {
        "properties": {
          "bug_description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Bug Description"
          }
        },
        "type": "object",
        "required": [
          "bug_description"
        ],
        "title": "BugInvestigationRequest"
      },
      "CitationResponse": {
        "properties": {
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "start_line": {
            "type": "integer",
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "title": "End Line"
          }
        },
        "type": "object",
        "required": [
          "file_path",
          "start_line",
          "end_line"
        ],
        "title": "CitationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PatchDecisionRequest": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ApprovalDecision"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "PatchDecisionRequest"
      },
      "PatchProposalRequest": {
        "properties": {
          "task_description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Task Description"
          }
        },
        "type": "object",
        "required": [
          "task_description"
        ],
        "title": "PatchProposalRequest"
      },
      "PatchProposalResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "repository_id": {
            "type": "string",
            "format": "uuid",
            "title": "Repository Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "diff_text": {
            "type": "string",
            "title": "Diff Text"
          },
          "target_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Target Files"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "status": {
            "$ref": "#/components/schemas/PatchStatus"
          },
          "test_command": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Command"
          },
          "test_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Output"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "repository_id",
          "conversation_id",
          "diff_text",
          "target_files",
          "rationale",
          "status",
          "test_command",
          "test_output",
          "decided_by",
          "decided_at",
          "created_at"
        ],
        "title": "PatchProposalResponse"
      },
      "PatchStatus": {
        "type": "string",
        "enum": [
          "pending_approval",
          "approved",
          "rejected",
          "test_run_passed",
          "test_run_failed",
          "applied"
        ],
        "title": "PatchStatus"
      },
      "QuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QuestionRequest"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "RepositoryCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "source_url"
        ],
        "title": "RepositoryCreateRequest"
      },
      "RepositoryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "status": {
            "$ref": "#/components/schemas/RepositoryStatus"
          },
          "status_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Detail"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Sha"
          },
          "file_count": {
            "type": "integer",
            "title": "File Count"
          },
          "symbol_count": {
            "type": "integer",
            "title": "Symbol Count"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "source_url",
          "status",
          "status_detail",
          "commit_sha",
          "file_count",
          "symbol_count",
          "chunk_count",
          "created_at",
          "updated_at"
        ],
        "title": "RepositoryResponse"
      },
      "RepositoryStatus": {
        "type": "string",
        "enum": [
          "pending",
          "cloning",
