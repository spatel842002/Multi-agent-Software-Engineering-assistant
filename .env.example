# Optional host-port overrides for `docker compose up`, read automatically
# from a root `.env` file by Docker Compose. Only needed if a default port
# is already taken on your machine by something else. Copy to `.env` and
# change only what conflicts.

POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
OLLAMA_PORT=11434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
